{
    "version": 2,
    "builds": [
      { "src": "api/index.js", "use": "@vercel/node" }
    ],
    "routes": [
      { "src": "/auth/(.*)", "dest": "/api/index.js" },
      { "src": "/user/(.*)", "dest": "/api/index.js" },
      { "src": "/posts/(.*)", "dest": "/api/index.js" },
      { "src": "/admin/(.*)", "dest": "/api/index.js" }
    ]
}
  